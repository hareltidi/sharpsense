{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SharpSense Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/test-workspace"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: compile",
      "timeout": 120000
    }
  ]
}
